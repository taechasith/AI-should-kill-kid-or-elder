{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geosave/experiment_config/v1",
  "title": "GeoSAVE Experiment Configuration v1",
  "type": "object",
  "required": ["schema_version", "experiment_id", "law_snapshot", "scenarios", "jurisdictions", "models", "conditions", "generation"],
  "properties": {
    "schema_version": {"const": "v1"},
    "models": {"type": "array", "minItems": 1},
    "conditions": {"type": "array", "minItems": 1},
    "generation": {"type": "object", "required": ["seed", "repetitions"]}
  }
}
