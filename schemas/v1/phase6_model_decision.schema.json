{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geosave/phase6-model-decision/v1",
  "title": "GeoSAVE Phase 6 normalized model decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_id", "model_revision", "prompt_version", "condition", "input_package_id", "country_iso3", "law_snapshot", "action_order", "raw_response_reference", "parse_status", "repair_attempted", "decision_status", "selected_action_id", "stated_factors", "legal_claims", "evidence_ids_cited", "uncertainty_statement", "short_rationale", "parse_error"],
  "properties": {
    "schema_version": {"const": "phase6-model-decision-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "condition": {"enum": ["C0", "C1", "C2", "C3", "C4"]},
    "input_package_id": {"type": "string", "minLength": 1},
    "country_iso3": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "law_snapshot": {"type": "string", "minLength": 1},
    "action_order": {"type": "array", "items": {"enum": ["A0", "A1", "A2", "A3", "A4", "A6"]}, "minItems": 6, "maxItems": 6, "uniqueItems": true},
    "raw_response_reference": {"type": "string", "minLength": 1},
    "parse_status": {"enum": ["valid", "repaired", "failed"]},
    "repair_attempted": {"type": "boolean"},
    "decision_status": {"enum": ["CHOOSE", "ABSTAIN", "INSUFFICIENT_INFORMATION", "INVALID"]},
    "selected_action_id": {"type": ["string", "null"], "enum": ["A0", "A1", "A2", "A3", "A4", "A6", null]},
    "stated_factors": {"type": "array", "items": {"enum": ["braking_distance", "collision_avoidance", "ego_speed", "geosave_constraint", "insufficient_legal_evidence", "legal_uncertainty", "lane_boundary", "lane_marking", "motorcycle_conflict", "obstacle_clearance", "operational_uncertainty", "pedestrian_conflict", "road_boundary", "supplied_legal_rule", "vehicle_stability"]}, "uniqueItems": true},
    "legal_claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_type", "action_id", "statement", "evidence_ids"], "properties": {"claim_type": {"enum": ["duty", "exception", "lawfulness", "uncertainty"]}, "action_id": {"type": ["string", "null"], "enum": ["A0", "A1", "A2", "A3", "A4", "A6", null]}, "statement": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "evidence_ids_cited": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uncertainty_statement": {"type": "string"},
    "short_rationale": {"type": "string"},
    "parse_error": {"type": ["string", "null"]}
  }
}
