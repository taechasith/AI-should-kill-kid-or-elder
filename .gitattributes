docs/PHASE_5_LEGAL_REVIEW.md text eol=lf
docs/PHASE_5_SOURCES.md text eol=lf
requirements-phase5.txt text eol=lf
scripts/build_phase5_query_universe.py text eol=lf
scripts/collect_who_global_context.py text eol=lf
scripts/finalize_phase5_legal_snapshot.py text eol=lf
scripts/generate_phase5_docs.py text eol=lf
scripts/materialize_phase5_legal_snapshot.py text eol=lf
scripts/validate_phase5_legal_snapshot.py text eol=lf
scripts/verify_phase5_hashes.py text eol=lf
scripts/verify_phase5_sources.py text eol=lf
