# Keep this policy file itself stable across Windows and Linux checkouts.
/.gitattributes text eol=lf

# The Phase 5 snapshot hashes exact file bytes.  Keep all hashed text artifacts
# LF-normalized in every checkout, including on Windows with core.autocrlf set.
configs/legal/phase5_two_level_v1.json text eol=lf
configs/simulator/actions_v1.yaml text eol=lf
data/legal/phase5/** text eol=lf
docs/LEGAL_DATA_CARD.md text eol=lf
docs/PHASE_5_COVERAGE.md text eol=lf
docs/PHASE_5_LEGAL_REVIEW.md text eol=lf
docs/PHASE_5_SOURCES.md text eol=lf
requirements-phase5.txt text eol=lf
scripts/build_phase5_query_universe.py text eol=lf
scripts/collect_who_global_context.py text eol=lf
scripts/finalize_phase5_legal_snapshot.py text eol=lf
scripts/generate_phase5_docs.py text eol=lf
scripts/materialize_phase5_legal_snapshot.py text eol=lf
scripts/validate_phase5_legal_snapshot.py text eol=lf
scripts/verify_phase5_hashes.py text eol=lf
scripts/verify_phase5_sources.py text eol=lf

# Phase 6 dry-run hashes also bind exact generated inputs and manifests.
configs/experiments/phase6_model_interface_dry_run_v1.json text eol=lf
configs/models/phase6_model_registry_dry_run_v1.json text eol=lf
schemas/v1/phase6_model_decision.schema.json text eol=lf
prompts/phase6/decision_prompt_v1.md text eol=lf
